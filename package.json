{
  "name": "keystone-rules",
  "version": "0.3.0",
  "description": "Opinionated configuration package for LLM coding agents (Claude Code initially). Distributes skills, hooks, rules, and settings via a single CLI.",
  "type": "module",
  "bin": {
    "ks": "src/cli.js"
  },
  "main": "./src/cli.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/auth-check": "./src/lib/auth-check/index.js",
    "#lib/claude-invoker": "./src/lib/claude-invoker/index.js",
    "#lib/claude-md": "./src/lib/claude-md/index.js",
    "#lib/doctor-output": "./src/lib/doctor-output/index.js",
    "#lib/errors": "./src/lib/errors/index.js",
    "#lib/file-ops": "./src/lib/file-ops/index.js",
    "#lib/hooks": "./src/lib/hooks/index.js",
    "#lib/logger": "./src/lib/logger/index.js",
    "#lib/manifest": "./src/lib/manifest/index.js",
    "#lib/package-info": "./src/lib/package-info/index.js",
    "#lib/paths": "./src/lib/paths/index.js",
    "#lib/platform": "./src/lib/platform/index.js",
    "#lib/shared": "./src/lib/shared/index.js",
    "#lib/text-distance": "./src/lib/text-distance/index.js",
    "#commands": "./src/commands/index.js",
    "#cli": "./src/cli/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "!src/**/CLAUDE.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "claude-code",
    "llm",
    "ai-coding",
    "skills",
    "hooks",
    "rules",
    "configuration"
  ],
  "author": "Davy Massoneto <davy.massoneto@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/keystone-rules.git"
  },
  "bugs": {
    "url": "https://github.com/DavyMassoneto/keystone-rules/issues"
  },
  "homepage": "https://github.com/DavyMassoneto/keystone-rules#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3",
    "vitest": "^4.1.5"
  }
}
